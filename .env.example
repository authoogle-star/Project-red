# Real-time Threat Intelligence API Key
REAL_TIME_THREAT_INTELLIGENCE_API_KEY=your_threat_intelligence_api_key_here

# Additional Threat Intelligence API Key
THREAT_INTELLIGENCE_API_KEY=your_threat_intelligence_api_key_here

# SMTP Configuration for Alerts and Notifications
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here

# Email Configuration for OTP Interceptor
EMAIL_HOST=your_email_host_here
EMAIL_USERNAME=your_email_username_here
EMAIL_PASSWORD=your_email_password_here

# Twilio Configuration for OTP Interceptor
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Alert Email Configuration
ALERT_SENDER_EMAIL=alert@example.com
ALERT_RECIPIENT_EMAIL=admin@example.com

# Mobile Testing Configuration
DEMO_MODE=true

# TextBelt SMS Configuration (Free tier: 1 SMS/day)
TEXTBELT_API_KEY=textbelt

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=security-testing@yourcompany.com

# Infobip SMS/WhatsApp Configuration
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://g9vm5e.api.infobip.com
INFOBIP_FROM_NUMBER=447860088970
INFOBIP_WHATSAPP_ENABLED=true
